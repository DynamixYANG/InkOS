<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="InkOS.Studio.Views.ICloudView">
 <Border Classes="section"><StackPanel Spacing="14">
  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="ICLOUD / PRIVATE CALENDAR" Classes="label" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="Ghost" Command="{Binding OpenLinkCommand}" CommandParameter="https://account.apple.com/"><TextBlock Text="Apple Account ↗" FontFamily="{StaticResource StudioFont}" FontSize="12"/></Button></Grid>
  <Grid ColumnDefinitions="*,16,*"><StackPanel><TextBlock Text="APPLE ACCOUNT" Classes="label"/><TextBox x:Name="ICloudUsernameInput" Text="{Binding ICloudUsername,Mode=TwoWay}" PlaceholderText="name@icloud.com"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="APP-SPECIFIC PASSWORD" Classes="label"/><TextBox x:Name="ICloudPasswordInput" Text="{Binding ICloudPassword,Mode=TwoWay}" PasswordChar="●" PlaceholderText="Leave blank to keep saved password"/></StackPanel></Grid>
  <StackPanel Orientation="Horizontal" Spacing="12"><Button Classes="Outline" Command="{Binding DiscoverICloudCommand}"><TextBlock Text="Load calendars" FontFamily="{StaticResource StudioFont}" FontSize="12"/></Button><CheckBox Content="Show selected iCloud calendar" IsChecked="{Binding ICloudEnabled,Mode=TwoWay}"/></StackPanel>
  <StackPanel Spacing="6"><TextBlock Text="CALENDAR TO DISPLAY" Classes="label"/><ComboBox x:Name="ICloudCalendarInput" ItemsSource="{Binding ICloudCalendars}" SelectedItem="{Binding SelectedICloudCalendar,Mode=TwoWay}" PlaceholderText="Load calendars, then choose one"/></StackPanel>
  <StackPanel Orientation="Horizontal" Spacing="12"><Button Classes="Primary" Command="{Binding SaveICloudCommand}"><TextBlock Text="Save iCloud to screen" FontFamily="{StaticResource StudioFont}" FontSize="12"/></Button><Button Classes="Ghost" Command="{Binding DisconnectICloudCommand}"><TextBlock Text="Disconnect" FontFamily="{StaticResource StudioFont}" FontSize="12"/></Button></StackPanel>
  <TextBlock Text="{Binding ICloudStatus}" Classes="muted" TextWrapping="Wrap"/>
  <TextBlock Text="Use a dedicated app-specific password from Apple Account → Sign-In and Security. No public sharing required. InkOS only reads events; the Apple credential itself is not restricted to one calendar. The screen stores the credential and fetches the selected calendar without this app running." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
 </StackPanel></Border>
</UserControl>
