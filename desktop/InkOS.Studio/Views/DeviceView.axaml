<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="InkOS.Studio.Views.DeviceView">
 <StackPanel>
  <TextBlock Text="DEVICE / 05" Classes="label"/><TextBlock Text="Seven pages. Three keys." Classes="title" Margin="0,0,0,10"/>
  <TextBlock Text="The screen runs on its own. This app is only needed to change settings." Classes="muted" Margin="0,0,0,36"/>
  <Border Classes="section"><Grid ColumnDefinitions="110,*"><TextBlock Text="KEY 01" Classes="label"/><TextBlock Grid.Column="1" Text="Previous page" FontSize="18" FontWeight="Light"/></Grid></Border>
  <Border Classes="section"><Grid ColumnDefinitions="110,*"><TextBlock Text="KEY 02" Classes="label"/><TextBlock Grid.Column="1" Text="Next page" FontSize="18" FontWeight="Light"/></Grid></Border>
  <Border Classes="section"><Grid ColumnDefinitions="110,*"><TextBlock Text="KEY 03" Classes="label"/><TextBlock Grid.Column="1" Text="Home" FontSize="18" FontWeight="Light"/></Grid></Border>
  <TextBlock Text="HOME → MUSIC → WEATHER → WEEK → MOON → SUN → ENERGY" Classes="label" Margin="0,28,0,18" TextWrapping="Wrap"/>
  <StackPanel Orientation="Horizontal" Spacing="10"><Button  Classes="Outline" Command="{Binding NavigateCommand}" CommandParameter="prev"><TextBlock Text="← Previous" FontFamily="{StaticResource StudioFont}" FontWeight="Normal" FontSize="12"/></Button><Button  Classes="Outline" Command="{Binding NavigateCommand}" CommandParameter="next"><TextBlock Text="Next →" FontFamily="{StaticResource StudioFont}" FontWeight="Normal" FontSize="12"/></Button><Button  Classes="Primary" Command="{Binding NavigateCommand}" CommandParameter="home"><TextBlock Text="Home" FontFamily="{StaticResource StudioFont}" FontWeight="Normal" FontSize="12"/></Button></StackPanel>
  <Button  Classes="Ghost" HorizontalAlignment="Left" Margin="0,28,0,0" Command="{Binding ConnectCommand}"><TextBlock Text="Read current settings" FontFamily="{StaticResource StudioFont}" FontWeight="Normal" FontSize="12"/></Button>
  <Border Classes="section" Margin="0,32,0,0"><StackPanel Spacing="10"><TextBlock Text="ESP32 / FREERTOS / 800 × 480" Classes="label"/><TextBlock Text="Settings stay on the device. Subscription URLs and Spotify tokens are excluded from app logs and source packages." Classes="muted"/><TextBlock Text="InkOS Studio · ShadUI / Avalonia · IBM Plex Mono" Classes="muted" FontSize="11"/></StackPanel></Border>
 </StackPanel>
</UserControl>
