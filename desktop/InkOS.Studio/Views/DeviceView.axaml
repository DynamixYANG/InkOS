<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="InkOS.Studio.Views.DeviceView">
 <StackPanel>
  <TextBlock Text="DEVICE / 05" Classes="label"/><TextBlock Text="Seven pages. One dial." Classes="title" Margin="0,0,0,10"/>
  <TextBlock Text="The screen runs on its own. This app is only needed to change settings." Classes="muted" Margin="0,0,0,36"/>
  <Border Classes="section"><Grid ColumnDefinitions="110,*"><TextBlock Text="TURN A → B" Classes="label"/><TextBlock Grid.Column="1" Text="Next page" FontSize="18" FontWeight="Light"/></Grid></Border>
  <Border Classes="section"><Grid ColumnDefinitions="110,*"><TextBlock Text="TURN B → A" Classes="label"/><TextBlock Grid.Column="1" Text="Previous page" FontSize="18" FontWeight="Light"/></Grid></Border>
  <Border Classes="section"><Grid ColumnDefinitions="110,*"><TextBlock Text="PRESS" Classes="label"/><TextBlock Grid.Column="1" Text="Home / KEY3" FontSize="18" FontWeight="Light"/></Grid></Border>
  <TextBlock Text="HOME → MUSIC → WEATHER → WEEK → MOON → SUN → ENERGY" Classes="label" Margin="0,28,0,18" TextWrapping="Wrap"/>
  <Border Classes="section"><StackPanel Spacing="10"><TextBlock Text="PAGE SELECTION DELAY / SECONDS" Classes="label"/><TextBox Name="PageSwitchDelayInput" Text="{Binding PageSwitchDelayText,Mode=TwoWay}" MaxWidth="160" HorizontalAlignment="Left"/><TextBlock Text="Default 0.5 s · Range 0.1–5 s. The quiet period starts at the last turn or press and overlaps the title refresh. The final title stays visible for at least 0.1 s before the full page starts. Save to screen applies this setting." Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
  <Border Classes="section"><StackPanel Spacing="10"><TextBlock Text="ENCODER LOCK / SECONDS" Classes="label"/><TextBox Name="EncoderLockInput" Text="{Binding EncoderLockText,Mode=TwoWay}" MaxWidth="160" HorizontalAlignment="Left"/><TextBlock Text="Default 2 s · Range 0–10 s (0 disables). Starts when the settled selection is accepted for a full refresh. Turns during this interval are discarded, never replayed. The Home button remains available. Save to screen applies over USB or paired IP." Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
  <StackPanel Orientation="Horizontal" Spacing="10"><Button  Classes="Outline" Command="{Binding NavigateCommand}" CommandParameter="prev"><TextBlock Text="← Previous" FontFamily="{StaticResource StudioFont}" FontWeight="Normal" FontSize="12"/></Button><Button  Classes="Outline" Command="{Binding NavigateCommand}" CommandParameter="next"><TextBlock Text="Next →" FontFamily="{StaticResource StudioFont}" FontWeight="Normal" FontSize="12"/></Button><Button  Classes="Primary" Command="{Binding NavigateCommand}" CommandParameter="home"><TextBlock Text="Home" FontFamily="{StaticResource StudioFont}" FontWeight="Normal" FontSize="12"/></Button></StackPanel>
  <Button  Classes="Ghost" HorizontalAlignment="Left" Margin="0,28,0,0" Command="{Binding ConnectCommand}"><TextBlock Text="Read current settings" FontFamily="{StaticResource StudioFont}" FontWeight="Normal" FontSize="12"/></Button>
  <Border Classes="section" Margin="0,32,0,0"><StackPanel Spacing="10"><TextBlock Text="ESP32 / FREERTOS / 800 × 480" Classes="label"/><TextBlock Text="Settings stay on the device. Subscription URLs and Spotify tokens are excluded from app logs and source packages." Classes="muted"/><TextBlock Text="InkOS Studio · ShadUI / Avalonia · IBM Plex Mono" Classes="muted" FontSize="11"/></StackPanel></Border>
 </StackPanel>
</UserControl>
